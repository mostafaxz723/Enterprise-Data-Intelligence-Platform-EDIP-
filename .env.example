# Copy to .env (scripts/02-docker-prepare.ps1 does it for you). NEVER commit .env
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis
POSTGRES_DB=egypt_energy
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=dev-only-change-me
AIRFLOW_FERNET_KEY=
GRAFANA_PASSWORD=admin
# Services started by a plain `docker compose up -d` besides PostGIS (comma separated), e.g. airflow,cache
COMPOSE_PROFILES=

# --- chatbot (provider-agnostic: any OpenAI-compatible endpoint; see docs/FREE_DEPLOYMENT.md)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
