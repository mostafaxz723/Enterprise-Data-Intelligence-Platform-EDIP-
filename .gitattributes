# keep Linux-style line endings for files that run inside Docker / bash (Windows would otherwise break them)
* text=auto
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.py   text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf
*.png  binary
*.jpg  binary
*.glb  binary
*.gltf text eol=lf
